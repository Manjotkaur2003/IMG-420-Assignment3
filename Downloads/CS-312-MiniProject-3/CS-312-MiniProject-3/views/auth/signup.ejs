<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= (typeof title !=='undefined' ? title : "Blog" ) %>
  </title>

  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body>
  <nav class="navbar">
    <a href="/" class="brand">MiniProject-3 Blog</a>
    <div class="spacer"></div>
    <% if (currentUser) { %>
      <span>Hi, <%= currentUser.name %></span>
      <a class="btn" href="/posts/new">New Post</a>
      <form action="/signout" method="POST" style="display:inline;">
        <button class="btn danger" type="submit">Sign out</button>
      </form>
      <% } else { %>
        <a class="btn" href="/signin">Sign in</a>
        <a class="btn outline" href="/signup">Sign up</a>
        <% } %>
  </nav>
  <main class="container">
    <% if (error && error.length) { %>
      <div class="alert error">
        <%= error[0] %>
      </div>
      <% } %>
        <% if (success && success.length) { %>
          <div class="alert success">
            <%= success[0] %>
          </div>
          <% } %>
            <h1>Sign Up</h1>
            <form class="form" action="/signup" method="POST">
              <label>User ID
                <input type="text" name="user_id" required />
              </label>
              <label>Password
                <input type="password" name="password" required />
              </label>
              <label>Name
                <input type="text" name="name" required />
              </label>
              <button class="btn" type="submit">Create account</button>
              <p>Already have an account? <a href="/signin">Sign in</a></p>
            </form>
  </main>
  <footer class="footer">
    <p>&copy; <%= new Date().getFullYear() %> CS-312 Mini-Project-3</p>
  </footer>
</body>

</html>