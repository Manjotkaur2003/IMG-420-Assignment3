<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= (typeof title !=='undefined' ? title : "Blog" ) %>
  </title>

  <link rel="stylesheet" href="/css/styles.css" />
</head>

<body>
  <nav class="navbar">
    <a href="/" class="brand">MiniProject-3 Blog</a>
    <div class="spacer"></div>
    <% if (currentUser) { %>
      <span>Hi, <%= currentUser.name %></span>
      <a class="btn" href="/posts/new">New Post</a>
      <form action="/signout" method="POST" style="display:inline;">
        <button class="btn danger" type="submit">Sign out</button>
      </form>
      <% } else { %>
        <a class="btn" href="/signin">Sign in</a>
        <a class="btn outline" href="/signup">Sign up</a>
        <% } %>
  </nav>
  <main class="container">
    <% if (error && error.length) { %>
      <div class="alert error">
        <%= error[0] %>
      </div>
      <% } %>
        <% if (success && success.length) { %>
          <div class="alert success">
            <%= success[0] %>
          </div>
          <% } %>
            <h1>All Posts</h1>
            <div class="posts">
              <% if (posts.length===0) { %>
                <p>No posts yet.</p>
                <% } %>
                  <% posts.forEach(p=> { %>
                    <article class="post-card">
                      <h2><a href="/posts/<%= p.blog_id %>">
                          <%= p.title %>
                        </a></h2>
                      <p class="meta">By <strong>
                          <%= p.creator_name %>
                        </strong> • <%= new Date(p.date_created).toLocaleString() %>
                      </p>
                      <p>
                        <%= p.body.length> 220 ? p.body.slice(0,220)+"..." : p.body %>
                      </p>
                      <div class="actions">
                        <a class="btn small" href="/posts/<%= p.blog_id %>">Read</a>
                        <% if (currentUser && currentUser.user_id===p.creator_user_id) { %>
                          <a class="btn small outline" href="/posts/<%= p.blog_id %>/edit">Edit</a>
                          <form action="/posts/<%= p.blog_id %>?_method=DELETE" method="POST" style="display:inline;">
                            <button class="btn small danger" type="submit">Delete</button>
                          </form>
                          <% } %>
                      </div>
                    </article>
                    <% }) %>
            </div>
  </main>
  <footer class="footer">
    <p>&copy; <%= new Date().getFullYear() %> CS-312 Mini-Project-3</p>
  </footer>
</body>

</html>